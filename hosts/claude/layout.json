{
  "base_dir": ".claude/skills",
  "skill_dir": "<skill-id>",
  "skill_file": "SKILL.md",
  "frontmatter": {
    "name_field": "name",
    "description_field": "description",
    "extra_fields": []
  },
  "hooks": {
    "settings_file": ".claude/settings.json",
    "pre_tool_use": {
      "matcher": "Edit|Write|NotebookEdit",
      "command": "python ${workspaceFolder}/scripts/claude_gate_hook.py"
    }
  },
  "notes": "Claude Code 从项目 .claude/skills/<name>/SKILL.md 发现技能；hooks 从 .claude/settings.json 加载（PreToolUse exit 2 拦截写码）"
}
