    1:         self.assertEqual(len(manifest["skills"]), 14)
   15:         ids = [s["id"] for s in manifest["skills"]]
    2:         self.assertEqual(
    1:             sorted(ids),
    1:             ["architect", "bootstrap", "debug", "doc-driven", "evolution-scan",
                    "gate", "goal-creator", "memory-protocol", "no-fake-test", "pm",
                    "product-manager", "review", "ui-designer", "verify"])
