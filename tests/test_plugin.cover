    2: class TestMultiHostRoundtrip(unittest.TestCase):
    1:     """回归：多宿主 install 的 backup 互相覆盖（v0.2.0 真机发现）
           场景：同 target 装 reasonix + claude → 依次卸载 → 宿主文件全部恢复。"""
       
    1:     def _make_host(self, tmp):
    1:         host_root = os.path.join(tmp, "host")
               # reasonix 既有 skill
    1:         r = os.path.join(host_root, ".reasonix", "skills", "doc-driven")
    1:         os.makedirs(r, exist_ok=True)
    2:         with open(os.path.join(r, "SKILL.md"), "w", encoding="utf-8") as f:
    1:             f.write("R-ORIGINAL")
               # claude 既有 skill
    1:         c = os.path.join(host_root, ".claude", "skills", "doc-driven")
    1:         os.makedirs(c, exist_ok=True)
    2:         with open(os.path.join(c, "SKILL.md"), "w", encoding="utf-8") as f:
    1:             f.write("C-ORIGINAL")
               # 宿主已有 ddd_gate.py（模拟项目自带机械闸）
    1:         sdir = os.path.join(host_root, "scripts")
    1:         os.makedirs(sdir, exist_ok=True)
    2:         with open(os.path.join(sdir, "ddd_gate.py"), "w", encoding="utf-8") as f:
    1:             f.write("# HOST GATE VERSION")
    1:         return host_root
       
    1:     def test_multi_host_roundtrip(self):
    2:         with tempfile.TemporaryDirectory() as tmp:
    1:             host_root = self._make_host(tmp)
    3:             for host in ("reasonix", "claude"):
    4:                 with self.assertRaises(SystemExit) as ctx:
    2:                     install.main(["--host", host, "--target", host_root])
    2:                 self.assertEqual(ctx.exception.code, 0)
                   # 后装的 claude 不应破坏 reasonix 的备份目录
    2:             self.assertTrue(os.path.isdir(os.path.join(
    1:                 host_root, install.backup_dir_name("reasonix"))))
    2:             self.assertTrue(os.path.isdir(os.path.join(
    1:                 host_root, install.backup_dir_name("claude"))))
                   # 依次卸载
    3:             for host in ("claude", "reasonix"):
    4:                 with self.assertRaises(SystemExit) as ctx:
    2:                     uninstall.main(["--host", host, "--target", host_root])
    2:                 self.assertEqual(ctx.exception.code, 0)
                   # 全部恢复
    4:             with open(os.path.join(host_root, ".reasonix", "skills",
    3:                                    "doc-driven", "SKILL.md"), encoding="utf-8") as f:
    1:                 self.assertEqual(f.read(), "R-ORIGINAL")
    4:             with open(os.path.join(host_root, ".claude", "skills",
    3:                                    "doc-driven", "SKILL.md"), encoding="utf-8") as f:
    1:                 self.assertEqual(f.read(), "C-ORIGINAL")
    3:             with open(os.path.join(host_root, "scripts", "ddd_gate.py"),
    2:                       encoding="utf-8") as f:
    1:                 self.assertEqual(f.read(), "# HOST GATE VERSION")
                   # 零残留：宿主只保留原有文件（插件 skill 全部清除）
    2:             self.assertEqual(
    1:                 os.listdir(os.path.join(host_root, ".reasonix", "skills")),
    1:                 ["doc-driven"])
    2:             self.assertEqual(
    1:                 os.listdir(os.path.join(host_root, ".claude", "skills")),
    1:                 ["doc-driven"])
    2:             self.assertEqual(os.listdir(os.path.join(host_root, "scripts")),
    1:                              ["ddd_gate.py"])
    2:             self.assertEqual(
    7:                 [x for x in os.listdir(host_root)
    4:                  if x.startswith(".ddd-agent-plugin")], [])
       
       
    2: class TestHooks(unittest.TestCase):
    1:     """hooks 自动挂载：合并保留原 hooks / 无 settings 时创建删除（AC-5 扩展）"""
       
    1:     def test_merge_keeps_existing_hooks(self):
    2:         with tempfile.TemporaryDirectory() as tmp:
    1:             host_root = os.path.join(tmp, "host")
    1:             os.makedirs(os.path.join(host_root, ".reasonix"))
    2:             orig = {"hooks": {"PreToolUse": [
    2:                 {"matcher": "Bash",
    1:                  "hooks": [{"type": "command", "command": "echo hi"}]}]}}
    1:             sp = os.path.join(host_root, ".reasonix", "settings.json")
    2:             with open(sp, "w", encoding="utf-8") as f:
    1:                 json.dump(orig, f)
    2:             with self.assertRaises(SystemExit):
    1:                 install.main(["--host", "reasonix", "--target", host_root])
    2:             with open(sp, encoding="utf-8") as f:
    1:                 merged = json.load(f)
    3:             matchers = [e["matcher"] for e in merged["hooks"]["PreToolUse"]]
    1:             self.assertIn("Bash", matchers)                      # 原 hook 保留
    1:             self.assertIn("Edit|Write|NotebookEdit", matchers)   # 插件 hook 追加
                   # 卸载后恢复原状
    2:             with self.assertRaises(SystemExit):
    1:                 uninstall.main(["--host", "reasonix", "--target", host_root])
    2:             with open(sp, encoding="utf-8") as f:
    1:                 self.assertEqual(json.load(f), orig)
       
    1:     def test_create_and_remove_settings(self):
    2:         with tempfile.TemporaryDirectory() as tmp:
    1:             host_root = os.path.join(tmp, "host")
    1:             os.makedirs(os.path.join(host_root, ".reasonix"))
    1:             sp = os.path.join(host_root, ".reasonix", "settings.json")
    2:             with self.assertRaises(SystemExit):
    1:                 install.main(["--host", "reasonix", "--target", host_root])
    1:             self.assertTrue(os.path.isfile(sp))
    2:             with open(sp, encoding="utf-8") as f:
    2:                 self.assertIn("Edit|Write|NotebookEdit",
    1:                               json.dumps(json.load(f)))
    2:             with self.assertRaises(SystemExit):
    1:                 uninstall.main(["--host", "reasonix", "--target", host_root])
    1:             self.assertFalse(os.path.isfile(sp))  # 原本不存在 → 删除
       
       
    1: if __name__ == "__main__":
           unittest.main()
