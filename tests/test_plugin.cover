               # 模板文件齐全
   15:         for sid in ids:
   42:             self.assertTrue(os.path.isfile(
   14:                 os.path.join(ROOT, "templates", sid + ".md")),
   14:                 f"缺模板 templates/{sid}.md")
       
       
