    2: class TestDrift(unittest.TestCase):
    1:     """UT-2 drift 检出"""
       
    1:     def test_clean_then_drift(self):
    2:         with tempfile.TemporaryDirectory() as d:
    1:             _generate_once("reasonix", d)
    1:             base = os.path.join(d, "reasonix")
                   # 篡改
    1:             target = os.path.join(base, ".reasonix", "skills", "gate", "SKILL.md")
    2:             with open(target, "a", encoding="utf-8") as f:
    1:                 f.write("\ntampered\n")
    2:             diffs = drift_check.check_host(
    1:                 generate.load_manifest(), "reasonix", d)
    3:             self.assertTrue(any("gate" in x for x in diffs),
    1:                             f"应检出 gate 漂移，实际: {diffs}")
       
    1:     def test_missing_mirror(self):
    2:         with tempfile.TemporaryDirectory() as d:
    1:             diffs = drift_check.check_host(generate.load_manifest(), "claude", d)
    2:             self.assertTrue(any("missing" in x for x in diffs))
       
       
    2: class TestInstallUninstall(unittest.TestCase):
    1:     """UT-3 install/uninstall 可逆（AC-5）"""
       
    1:     def _make_host(self, tmp):
               """构造宿主：预置一个与插件同名的既有 skill（验证覆盖+恢复）。"""
    2:         host_root = os.path.join(tmp, "host")
    2:         pre = os.path.join(host_root, ".reasonix", "skills", "doc-driven")
    2:         os.makedirs(pre, exist_ok=True)
    4:         with open(os.path.join(pre, "SKILL.md"), "w", encoding="utf-8") as f:
    2:             f.write("USER ORIGINAL")
    2:         return host_root
       
    1:     def test_roundtrip(self):
    2:         with tempfile.TemporaryDirectory() as tmp:
    1:             host_root = self._make_host(tmp)
                   # 安装（main 以 sys.exit(0) 收尾）
    2:             with self.assertRaises(SystemExit) as ictx:
    1:                 install.main(["--host", "reasonix", "--target", host_root])
    1:             self.assertEqual(ictx.exception.code, 0)
                   # 覆盖生效
    4:             with open(os.path.join(
    1:                     host_root, ".reasonix", "skills", "doc-driven", "SKILL.md"),
    2:                     encoding="utf-8") as f:
    1:                 self.assertIn("doc-driven", f.read(200))
                   # 卸载
    2:             with self.assertRaises(SystemExit) as uctx:
    1:                 uninstall.main(["--host", "reasonix", "--target", host_root])
    1:             self.assertEqual(uctx.exception.code, 0)
                   # 原文件恢复
    4:             with open(os.path.join(
    1:                     host_root, ".reasonix", "skills", "doc-driven", "SKILL.md"),
    2:                     encoding="utf-8") as f:
    1:                 self.assertEqual(f.read(), "USER ORIGINAL")
                   # 插件文件已清空（6 skill + scripts 全部移除）
    1:             skills = os.listdir(os.path.join(host_root, ".reasonix", "skills"))
    1:             self.assertEqual(skills, ["doc-driven"])
       
    1:     def test_uninstall_without_manifest_refused(self):
    2:         with tempfile.TemporaryDirectory() as tmp:
    1:             host_root = self._make_host(tmp)
                   # 无 manifest → 拒绝卸载
    2:             with self.assertRaises(SystemExit) as ctx:
    1:                 uninstall.main(["--host", "reasonix", "--target", host_root])
    1:             self.assertEqual(ctx.exception.code, 1)
       
       
    2: class TestManifest(unittest.TestCase):
