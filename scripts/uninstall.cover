           # 2.5) hooks 恢复：settings.json 还原为安装前状态
    5:     hooks_restored = False
    5:     hook_state = record.get("hooks")
    5:     if hook_state:
    5:         settings_path = os.path.join(target, hook_state["settings_file"])
    5:         if hook_state["existed"]:
                   # 从备份恢复原 settings.json（保留宿主原有 hooks/其他配置）
    1:             bp = os.path.join(backup_dir, hook_state["settings_file"])
    1:             if os.path.isfile(bp):
    1:                 os.makedirs(os.path.dirname(settings_path), exist_ok=True)
    1:                 shutil.copy2(bp, settings_path)
