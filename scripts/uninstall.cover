       删除 manifest 与 backup → 校验宿主 skill 目录与安装前快照一致。
       
       用法：
         python scripts/uninstall.py --host <name> --target <宿主项目根>
       退出码：0 = 卸载并校验通过；1 = 无 manifest 或校验失败（拒绝执行/报错）。
       """
    1: import argparse
    1: import json
    1: import os
    1: import shutil
    1: import sys
       
    1: import install
       
    1: MANIFEST_PREFIX = install.MANIFEST_PREFIX
    1: BACKUP_PREFIX = install.BACKUP_PREFIX
       
       
    1: def manifest_name(host):
    6:     return f"{MANIFEST_PREFIX}-{host}.json"
       
       
    1: def backup_dir_name(host):
    5:     return f"{BACKUP_PREFIX}-{host}"
       
       
    1: def main(argv=None):
    6:     ap = argparse.ArgumentParser(description="卸载插件（恢复宿主原状）")
    6:     ap.add_argument("--host", required=True, help="reasonix|claude")
