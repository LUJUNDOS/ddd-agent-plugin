    6:     args = ap.parse_args(argv)
       
    6:     target = os.path.abspath(args.target)
    6:     mpath = os.path.join(target, manifest_name(args.host))
    6:     if not os.path.isfile(mpath):
    1:         print(f"[FAIL] 未找到安装清单 {os.path.basename(mpath)}（拒绝卸载）")
    1:         sys.exit(1)
   10:     with open(mpath, "r", encoding="utf-8") as f:
    5:         record = json.load(f)
    5:     if record["host"] != args.host:
               print(f"[FAIL] 清单宿主 {record['host']} 与参数 {args.host} 不符")
               sys.exit(1)
       
           # 1) 删除插件文件（仅删清单记录的）
    5:     deleted, missing = [], []
  265:     for relp in record["files"]:
  260:         fp = os.path.join(target, relp)
  260:         if os.path.isfile(fp):
  260:             os.remove(fp)
  260:             deleted.append(relp)
               else:
                   missing.append(relp)
       
           # 2) 恢复被覆盖文件
    5:     backup_dir = os.path.join(target, backup_dir_name(args.host))
    5:     restored = []
   47:     for relp in record["backed_up"]:
   42:         bp = os.path.join(backup_dir, relp)
   42:         if os.path.isfile(bp):
