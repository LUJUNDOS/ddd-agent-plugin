    5:     all_dirs = []
  159:     for dirpath, dirnames, filenames in os.walk(target):
  154:         all_dirs.append(dirpath)
  159:     for d in reversed(all_dirs):
  154:         if d == target:
    5:             continue
  149:         try:
  149:             os.rmdir(d)
   60:         except OSError:
   60:             pass  # 非空目录，保留
    5:     os.remove(mpath)
    5:     shutil.rmtree(backup_dir, ignore_errors=True)
       
           # 4) 校验：宿主 skill 目录与安装前快照一致（AC-5）
    5:     base_dir = os.path.join(target, record["base_dir"].strip("/"))
    5:     now = install._snapshot(base_dir)
    5:     diff = []
    8:     for k in set(record["snapshot"]) | set(now):
