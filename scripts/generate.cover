       #!/usr/bin/env python3
       # -*- coding: utf-8 -*-
    1: """
       generate.py —— 从单一源生成各宿主镜像（03-design §4 / AD-0001）
       
       读 plugin.manifest.yaml × templates/*.md × hosts/<host>/layout.json，
       渲染 dist/<host>/ 完整镜像（skills 目录树 + scripts 拷贝 + layout 元数据）。
       纯标准库实现（string.Template），无第三方依赖（NFR-01）。
       
       用法：
         python scripts/generate.py [--host <name|all>] [--out dist]
       退出码：0 = 成功；1 = 失败（manifest 解析 / 模板缺失 / 宿主未声明）。
       """
    1: import argparse
    1: import json
    1: import os
    1: import re
    1: import shutil
    1: import string
    1: import sys
       
    1: SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
    1: ROOT = os.path.dirname(SCRIPT_DIR)
       
       
       # ---------- 极简 YAML 子集解析（仅支持本 manifest 用到的结构） ----------
       
    1: def _scalar(v):
 1292:     v = v.strip()
 1292:     if v in ("true", "True"):
               return True
 1292:     if v in ("false", "False"):
               return False
 1292:     if v in ("null", "~"):
               return None
 1292:     if re.fullmatch(r"-?\d+", v):
               return int(v)
 1292:     if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
  285:         return v[1:-1]
 1007:     return v
       
       
    1: def parse_yaml_subset(text):
           """解析：注释 / 嵌套 mapping / `- key: val` 列表项 / `- val` 列表项。
           非本项目用到的 YAML 特性会抛 ValueError（fail-fast，宁缺毋滥）。"""
 4522:     lines = [ln for ln in text.splitlines()
 3002:              if ln.strip() and not ln.strip().startswith("#")]
   19:     root = {}
   19:     stack = [(-1, root)]      # (indent, dict)
   19:     list_stack = []           # (indent, list)
   19:     i = 0
 1482:     while i < len(lines):
 1463:         line = lines[i]
 1463:         indent = len(line) - len(line.lstrip())
 1463:         content = line.strip()
 1463:         if content.startswith("- "):
  532:             rest = content[2:].strip()
  532:             while list_stack and list_stack[-1][0] >= indent:
                       list_stack.pop()
  532:             if not list_stack:
                       raise ValueError(f"列表项无容器: {line}")
  532:             lst = list_stack[-1][1]
  532:             m = re.match(r"^([A-Za-z0-9_\-]+)\s*:\s*(.*)$", rest)
  532:             if m:
  266:                 item = {}
  266:                 lst.append(item)
  266:                 item[m.group(1)] = _scalar(m.group(2))
  266:                 stack.append((indent, item))
                   else:
  266:                 lst.append(_scalar(rest))
               else:
  931:             m = re.match(r"^([A-Za-z0-9_\-]+)\s*:\s*(.*)$", content)
  931:             if not m:
                       raise ValueError(f"无法解析: {line}")
  931:             key, val = m.group(1), m.group(2).strip()
 1311:             while stack and stack[-1][0] >= indent:
  380:                 stack.pop()
  931:             cur = stack[-1][1]
  931:             if val == "":
  171:                 if i + 1 < len(lines):
  171:                     nxt = lines[i + 1]
  171:                     nindent = len(nxt) - len(nxt.lstrip())
  171:                     ncontent = nxt.strip()
  171:                     if ncontent.startswith("- "):
   57:                         new_list = []
   57:                         cur[key] = new_list
   57:                         list_stack.append((indent, new_list))
  114:                     elif nindent > indent:
  114:                         new_dict = {}
  114:                         cur[key] = new_dict
  114:                         stack.append((indent, new_dict))
                           else:
                               cur[key] = None
                       else:
                           cur[key] = None
  760:             elif val.startswith("[") and val.endswith("]"):
                       cur[key] = json.loads(val)
                   else:
  760:                 cur[key] = _scalar(val)
 1463:         i += 1
   19:     return root
       
       
       # ---------- 生成 ----------
       
    1: def load_manifest():
   19:     path = os.path.join(ROOT, "plugin.manifest.yaml")
   38:     with open(path, "r", encoding="utf-8") as f:
   19:         return parse_yaml_subset(f.read())
       
       
    1: def render_skill(tpl_path, skill):
  504:     with open(tpl_path, "r", encoding="utf-8") as f:
  252:         tpl = f.read()
           # 03-design §4：{{SKILL_NAME}}/{{SKILL_DESC}} 占位符（string.Template 不认 {{}}，用显式替换）
  504:     return (tpl
  252:             .replace("{{SKILL_NAME}}", skill["id"])
  252:             .replace("{{SKILL_DESC}}", skill["description"]))
       
       
    1: def generate_host(manifest, host, out_dir):
   18:     host_cfg = manifest["hosts"][host]
   18:     layout_path = host_cfg.get("layout")
   18:     if not layout_path:
               raise ValueError(f"宿主 {host} 未声明 layout（planned 状态，未适配）")
   36:     with open(os.path.join(ROOT, layout_path), "r", encoding="utf-8") as f:
   18:         layout = json.load(f)
   18:     base = os.path.join(out_dir, host)
   18:     base_dir = layout["base_dir"].strip("/")
  270:     for skill in manifest["skills"]:
  252:         skill_dir = layout["skill_dir"].replace("<skill-id>", skill["id"])
  252:         dest = os.path.join(base, base_dir, skill_dir)
  252:         os.makedirs(dest, exist_ok=True)
  504:         body = render_skill(
  252:             os.path.join(ROOT, "templates", skill["id"] + ".md"), skill)
  504:         with open(os.path.join(dest, layout["skill_file"]), "w", encoding="utf-8") as f:
  252:             f.write(body)
           # 拷贝随插件分发的脚本
   18:     scripts_out = os.path.join(base, "scripts")
   18:     os.makedirs(scripts_out, exist_ok=True)
   90:     for s in manifest.get("scripts", []):
   72:         src = os.path.join(ROOT, s)
   72:         if os.path.isfile(src):
   72:             shutil.copy2(src, os.path.join(scripts_out, os.path.basename(s)))
           # 拷贝 references（角色 skill 的方法论依赖，03-design §13；目录递归拷贝保留子结构）
   18:     refs_out = os.path.join(base, "references")
  198:     for r in manifest.get("references", []):
  180:         src = os.path.join(ROOT, r)
  180:         if os.path.isdir(src):
  108:             shutil.copytree(src, os.path.join(refs_out, os.path.basename(r)),
   54:                             dirs_exist_ok=True)
  126:         elif os.path.isfile(src):
  126:             os.makedirs(refs_out, exist_ok=True)
  126:             shutil.copy2(src, os.path.join(refs_out, os.path.basename(r)))
           # layout 元数据（install 用；不进宿主）
   36:     with open(os.path.join(base, "layout.json"), "w", encoding="utf-8") as f:
   18:         json.dump(layout, f, ensure_ascii=False, indent=2)
   18:     return base
       
       
    1: def main():
           ap = argparse.ArgumentParser(description="生成各宿主镜像（单一源）")
           ap.add_argument("--host", default="all", help="reasonix|claude|all（默认 all）")
           ap.add_argument("--out", default="dist", help="输出目录（默认 dist）")
           args = ap.parse_args()
       
           manifest = load_manifest()
           host_names = [h for h, c in manifest["hosts"].items() if c.get("layout")]
           if args.host != "all":
               if args.host not in manifest["hosts"]:
                   print(f"[FAIL] 未知宿主: {args.host}（可用: {list(manifest['hosts'])}）")
                   sys.exit(1)
               host_names = [args.host]
           out_dir = os.path.join(ROOT, args.out)
           os.makedirs(out_dir, exist_ok=True)
           produced = []
           for host in host_names:
               produced.append(generate_host(manifest, host, out_dir))
           print(f"generate: {host_names} -> {os.path.abspath(out_dir)}")
           for p in produced:
               print(f"  {os.path.relpath(p, ROOT)}")
           sys.exit(0)
       
       
    1: if __name__ == "__main__":
           main()
