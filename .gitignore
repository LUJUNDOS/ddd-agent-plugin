# 密钥 / 凭证
.env
.env.*
*.secret
secrets/
**/.secrets/

# 产物 / 依赖
__pycache__/
*.pyc
node_modules/
build/
dist/
*.egg-info/
.venv/

# AI 工具 / 编辑器本地配置（工具级，跨项目复制维护，不入库）
.claude/
.codebuddy/
.vscode/
.reasonix/

# 运行时产出（执行时生成，可重跑）
proposals/
tasks/logs/
validations/

# 运行时契约（/goal 流程按需生成，可重跑；模板在根目录 contracts/_templates/）
contracts/

# 工作区级资产（所有项目共用，根目录维护）
tools/

# OS / 编辑器临时文件
.DS_Store
Thumbs.db
*.swp

# 临时
.temp/
*.tmp
